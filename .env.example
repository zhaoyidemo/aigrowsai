# 独立服务基础配置
DATABASE_URL=
ADMIN_USERNAME=admin
# 至少 12 个字符，只放 Railway Secret，不得提交真实值
ADMIN_PASSWORD=
# 至少 32 个随机字符，只放 Railway Secret
SESSION_SECRET=
AUTH_COOKIE_SECURE=true

# 真实工作流
QIJIA_VIDEO_STORAGE=tos
QIJIA_VIDEO_EXECUTION_MODE=process
REMOTION_CONCURRENCY=1

# 脚本和分镜
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
QIJIA_VIDEO_SCRIPT_MODEL=x-ai/grok-4.5
# 联网研究使用 Grok 4.5 + OpenRouter 托管 Exa，不配置 Google/Gemini 回退
QIJIA_VIDEO_RESEARCH_MODEL=x-ai/grok-4.5

# 家庭教育选题研究（仅抖音）。真实 Key 只放 Railway Secret。
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev
# 留空时复用 QIJIA_VIDEO_SCRIPT_MODEL
QIJIA_TOPIC_RESEARCH_MODEL=
# 单轮请求硬上限；按固定汇率折算为 ¥0.67，当前固定流程最多使用 13 次
QIJIA_TOPIC_TIKHUB_REQUEST_BUDGET=100
# 选题研究 / 短链解析规划价（USD/成功请求）；实际账单优先
QIJIA_TOPIC_TIKHUB_ESTIMATED_USD_PER_SUCCESS=0.001
# 星图 V2 抖音效果回流规划价（USD/成功请求）
QIJIA_VIDEO_TIKHUB_PERFORMANCE_USD_PER_SUCCESS=0.002

# Seedream 与 Seedance 共用同一把火山方舟 Key
ARK_API_KEY=
QIJIA_VIDEO_SEEDREAM_MODEL=doubao-seedream-5-0-lite-260128
# 官网按量刊例价（CNY/张）；发生调用时保存价格快照
QIJIA_VIDEO_SEEDREAM_PRICE_PER_IMAGE=0.22
# 仅供没有冻结模型的历史请求回退；新任务固定默认 1.0 Pro Fast
QIJIA_VIDEO_SEEDANCE_MODEL=doubao-seedance-1-0-pro-fast-251015
QIJIA_VIDEO_SEEDANCE_PRICE_PER_MILLION=4.2
# 模型专属官网按量刊例价（CNY/百万 tokens）；发生调用时保存价格快照
QIJIA_VIDEO_SEEDANCE_10_FAST_PRICE_PER_MILLION=4.2
# 仅用于已有 1.5 Pro 历史任务的成本补算
QIJIA_VIDEO_SEEDANCE_15_PRICE_PER_MILLION=8.0
QIJIA_VIDEO_SEEDANCE_20_PRICE_PER_MILLION=46.0

# 豆包 TTS 2.0
VOLCENGINE_SPEECH_API_KEY=
QIJIA_VIDEO_TTS_RESOURCE_ID=seed-tts-2.0
QIJIA_VIDEO_TTS_VOICE_ID=zh_female_vv_uranus_bigtts
# 官网按量刊例价；如账号套餐价不同，可在 Railway Secret 中覆盖
QIJIA_VIDEO_TTS_PRICE_PER_10000_CHARACTERS=5.0

# 火山 TOS；继续使用 qijia-video/ 对象前缀
VOLCENGINE_TOS_ACCESS_KEY_ID=
VOLCENGINE_TOS_SECRET_ACCESS_KEY=
VOLCENGINE_TOS_BUCKET=
VOLCENGINE_TOS_REGION=cn-shanghai
