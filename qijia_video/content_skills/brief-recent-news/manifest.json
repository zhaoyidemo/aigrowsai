{
  "schema_version": "1.0",
  "version": "2.1.0",
  "display_name": "最新新闻口播",
  "input_mode": "recent_news_topic",
  "compatible_formats": ["recent_news_briefing"],
  "default_for_formats": ["recent_news_briefing"],
  "research_mode": "recent_news_required",
  "policy_ids": [
    "source-grounding",
    "news-freshness",
    "event-publish-time-separation",
    "uncertainty-labeling"
  ],
  "quality_rules": [
    "至少使用一条可与检索注释匹配的可追溯公开证据；时间缺失、单站点或来源类型不完整时必须醒目标注",
    "明确检索截止时间，不把旧闻包装成刚发生",
    "区分事件发生时间与文章发布时间",
    "预测、计划和传闻不得表述为既成事实"
  ]
}
